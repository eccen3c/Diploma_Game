  - key: tooltip_atkspd
    value: "\u0428\u0432\u0438\u0434. \u0430\u0442\u0430\u043A\u0438"
  - key: tooltip_speed
    value: "\u0428\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C"
  - key: htp_title
    value: "\u042F\u041A \u0413\u0420\u0410\u0422\u0418"
  - key: htp_content
    value: "  1. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439
      WASD (\u04131) \u0430\u0431\u043E \u0421\u0442\u0440\u0456\u043B\u043A\u0438
      (\u04132) \u0449\u043E\u0431 \u043E\u0431\u0440\u0430\u0442\u0438 \u044E\u043D\u0456\u0442\u0430
      \u0432 \u0448\u043E\u043F\u0456. \u041E\u0431\u0440\u0430\u043D\u0438\u0439
      \u044E\u043D\u0456\u0442 \u0437'\u044F\u0432\u0438\u0442\u044C\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u0432 \u043F\u043E\u0447\u0430\u0442\u043A\u0443
      \u043A\u043E\u0436\u043D\u043E\u0457 \u0432\u043E\u043B\u043D\u0438, \u043A\u043E\u043B\u0438
      \u0442\u0430\u0439\u043C\u0435\u0440 \u0434\u0456\u0439\u0434\u0435 \u0434\u043E
      \u043D\u0443\u043B\u044F.\r\n\r\n  2. \u041D\u0430\u0432\u0435\u0434\u0438
      \u043C\u0438\u0448\u043A\u0443 \u043D\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0433\u043E
      \u044E\u043D\u0456\u0442\u0430 \u0449\u043E\u0431 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
      \u0439\u043E\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:
      HP, \u0443\u0440\u043E\u043D, \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C,
      \u0432\u0430\u0440\u0442\u0456\u0441\u0442\u044C \u0442\u0430 \u0431\u043E\u043D\u0443\u0441
      \u0434\u043E\u0445\u043E\u0434\u0443.\r\n\r\n  3. \u041A\u043E\u0436\u0435\u043D
      \u044E\u043D\u0456\u0442 \u043D\u0430 \u043F\u043E\u043B\u0456 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
      \u0434\u043E\u0445\u0456\u0434 \u2014 \u0447\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435
      \u044E\u043D\u0456\u0442\u0456\u0432, \u0442\u0438\u043C \u0448\u0432\u0438\u0434\u0448\u0435
      \u0440\u043E\u0441\u0442\u0435 \u0437\u043E\u043B\u043E\u0442\u043E.\r\n\r\n 
      4. \u0417\u043D\u0438\u0449 \u0431\u0430\u0437\u0443 \u0432\u043E\u0440\u043E\u0433\u0430
      \u2014 \u0456 \u043F\u0435\u0440\u0435\u043C\u043E\u0433\u0430 \u0442\u0432\u043E\u044F!\r\n\r\n 
      5. \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439
      \u043C\u0456\u043D\u0456\u043A\u0430\u0440\u0442\u0443 \u0449\u043E\u0431 \u0441\u0442\u0435\u0436\u0438\u0442\u0438
      \u0437\u0430 \u0431\u0438\u0442\u0432\u043E\u044E.\n\r\n  6. \u0412\u0435\u0440\u0445\u043D\u044F
      \u043F\u0430\u043D\u0435\u043B\u044C \u043F\u043E\u043A\u0430\u0437\u0443\u0454
      \u0442\u0432\u043E\u0457 \u043F\u043E\u043A\u0430\u0437\u043D\u0438\u043A\u0438:\r\n    
      \u0417\u043E\u043B\u043E\u0442\u043E \u2014 \u043F\u043E\u0442\u043E\u0447\u043D\u0430
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0434\u043B\u044F \u0432\u0438\u0442\u0440\u0430\u0442\r\n    
      \u0414\u043E\u0445\u0456\u0434 \u2014 \u0437\u043E\u043B\u043E\u0442\u043E
      \u044F\u043A\u0435 \u043E\u0442\u0440\u0438\u043C\u0443\u0454\u0448 \u043A\u043E\u0436\u043D\u043E\u0457
      \u0432\u043E\u043B\u043D\u0438\n     \u041B\u0456\u043C\u0456\u0442 \u2014
      \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u044E\u043D\u0456\u0442\u0456\u0432
      \u043D\u0430 \u043F\u043E\u043B\u0456 \u0437 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
      \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u0438\u0445. \u0423 \u0432\u0441\u0456\u0445
      \u044E\u043D\u0456\u0442\u0456\u0432 \u0440\u0456\u0437\u043D\u0438\u0439 \u043B\u0456\u043C\u0456\u0442."
